+#if TARGET_OS_IOS
+namespace {
+SizeReturn SyncReadAll(int fd, void* buffer, size_t length, off_t offset) {
+  size_t done = 0;
+  auto* bytes = static_cast<uint8_t*>(buffer);
+  while (done < length) {
+    const ssize_t result = pread(fd, bytes + done, length - done, offset + static_cast<off_t>(done));
+    if (result < 0 && errno == EINTR) {
+      continue;
+    }
+    if (result <= 0) {
+      return result < 0 ? result : static_cast<SizeReturn>(done);
+    }
+    done += static_cast<size_t>(result);
+  }
+  return static_cast<SizeReturn>(done);
+}
+
+SizeReturn SyncWriteAll(int fd, const void* buffer, size_t length, off_t offset) {
+  size_t done = 0;
+  const auto* bytes = static_cast<const uint8_t*>(buffer);
+  while (done < length) {
+    const ssize_t result = pwrite(fd, bytes + done, length - done, offset + static_cast<off_t>(done));
+    if (result < 0 && errno == EINTR) {
+      continue;
+    }
+    if (result <= 0) {
+      return result < 0 ? result : static_cast<SizeReturn>(done);
+    }
+    done += static_cast<size_t>(result);
+  }
+  return static_cast<SizeReturn>(done);
+}
+} // namespace
+#endif
